{
  "name": "motion-and-tween",
  "version": "0.1.0",
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./location": {
      "types": "./dist/location/index.d.ts",
      "import": "./dist/location/index.js"
    },
    "./motion": {
      "types": "./dist/motion/index.d.ts",
      "import": "./dist/motion/index.js"
    },
    "./timing": {
      "types": "./dist/timing/index.d.ts",
      "import": "./dist/timing/index.js"
    },
    "./tween": {
      "types": "./dist/tween/index.d.ts",
      "import": "./dist/tween/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "index": [
        "./dist/index.d.ts"
      ],
      "motion": [
        "./dist/motion/index.d.ts"
      ],
      "location": [
        "./dist/location/index.d.ts"
      ],
      "timing": [
        "./dist/timing/index.d.ts"
      ],
      "tween": [
        "./dist/tween/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "keywords": [
    "motion",
    "tween",
    "tweening",
    "easing",
    "penner",
    "animation",
    "animation-library",
    "p5js",
    "p5-library"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rsegrest/motion-and-tween.git"
  },
  "bugs": {
    "url": "https://github.com/rsegrest/motion-and-tween/issues"
  },
  "homepage": "https://github.com/rsegrest/motion-and-tween#readme",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "tsc && jest",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "description": "Frame-based motion and Robert Penner-style easing tweens for any JavaScript object property (TypeScript, ES modules).",
  "license": "MIT",
  "author": {
    "name": "Rick Segrest",
    "email": "rsegrest77@gmail.com",
    "url": "https://www.ricksegrest.com"
  },
  "dependencies": {
    "es-vector-math": "^0.1.0"
  }
}
